# Stage 1: Build React app
FROM node:lts AS build
WORKDIR /usr/src/app

# Copy package.json and package-lock.json
COPY package*.json ./

# To resolve hostname, copy hosts file to Docker
COPY hosts /etc/hosts 

# Install dependencies, using force, though it 
# would be better to fix conflicts between versions
RUN npm install --force 

# Copy the rest of the application files
COPY . .

# Build the React app
RUN npm run build

# Stage 2: Use NGINX for serving the built React app
FROM nginx:latest

# Create directories for certificates
RUN mkdir -p /etc/nginx/cert

# Copy SSL certificates to the NGINX directory
COPY cert/client.crt /etc/nginx/cert/

# Overwrite NGINX default config with custom config
COPY nginx.conf /etc/nginx/nginx.conf

# Copy the built app to NGINX directory
COPY --from=build /usr/src/app/build /usr/share/nginx/html

# Copy SSL certificates to the NGINX directory
COPY cert/client.crt /etc/nginx/cert/client.crt
COPY cert/client.key /etc/nginx/cert/client.key

# Start NGINX with SSL
CMD ["nginx", "-g", "daemon off;"]
