# Use the Node.js base image
FROM node:latest

# Set the working directory
WORKDIR /usr/src/app

# Copy package.json and package-lock.json to the working directory
COPY package*.json ./

# Copy hosts file
COPY hosts /etc/hosts

# Install dependencies
RUN npm install

# Copy SSL certificate files
COPY cert/server.crt cert/server.key /usr/src/app/cert/

# Copy the rest of the application files to the working directory
COPY . .

# Copy the mongo_init_docker script into the working directory
COPY mongo_init_docker.sh /usr/src/app/mongo_init_docker.sh

# FIXME: WILL THIS WORK ? 
# RUN apt update && apt install -y pulseaudio

# ENV PULSE_SERVER = host.docker.internal

# set execution permissions
RUN chmod +x /usr/src/app/mongo_init_docker.sh

# Rebuild bcrypt to fix invalid ELF header issue
RUN npm rebuild bcrypt --build-from-source

# Build TypeScript to JavaScript
RUN npm run build

# Expose the necessary ports
EXPOSE 4000

# Copy the start_with_audio.sh script into the working directory
# COPY start_with_audio.sh /usr/src/app/start_with_audio.sh

# Grant execute permissions to the script
# RUN chmod +x /usr/src/app/start_with_audio.sh

# script for starting server 
CMD ["npx", "nodemon", "dist/server.js", "--ssl-cert=cert/server.crt", "--ssl-key=cert/server.key"]
