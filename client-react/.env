
# build command: docker build -f Dockerfile.client -t img_react_vite .

# up command: docker-compose -f ./docker-compose.client.yml up

# In case you make changes in your env file, run:

# 1. docker-compose -f ./docker-compose.client.yml down 

# 2. docker-compose -f ./docker-compose.client.yml up -d

# you can stop or run the containers in docker desktop as well


VITE_ENVIRONMENT = "development" # change this to development or production

VITE_ROUTER_DELETE_CODE = "BQjYa9kbAmxz" # code to delete router 

VITE_API_ENDPOINT_PROD = "https://webtonik.server:4000/webTonikApi" # api endpoint

VITE_API_ENDPOINT_DEV = "http://localhost:4000/webTonikApi" # api endpoint

HOSTNAME_CLIENT = "webtonik.client" # hostname for client 

IMAGE_CLIENT = "img_react_vite" # image name 

CONTAINER_NAME = "react_frontend_app" # container name 


